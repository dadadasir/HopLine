{
  "name": "hopline",
  "version": "0.4.0",
  "private": true,
  "description": "HopLine 开源版，支持 SSH、SFTP 和服务器管理",
  "author": "HopLine",
  "license": "AGPL-3.0-only",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run build:community",
    "build:community": "node scripts/build-edition.mjs community --package",
    "build:pro": "node scripts/build-edition.mjs pro --package",
    "build:win": "node scripts/build-edition.mjs community --package -- --win --x64 --publish never && npm run test:win-asar",
    "build:unpack": "node scripts/build-edition.mjs",
    "test": "vitest run",
    "test:smoke": "node tests/renderer-smoke.mjs",
    "test:win-asar": "node scripts/check-win-asar.mjs",
    "test:distro": "HOPLINE_DISTRO=1 vitest run -c vitest.distro.config.ts",
    "distro:capture": "HOPLINE_DISTRO=1 node tests/distro/capture.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "electron-builder install-app-deps",
    "perf:budget": "node scripts/perf-budget.mjs",
    "perf:runtime": "node scripts/perf-runtime.mjs",
    "perf:paired": "node scripts/perf-paired.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^6.0.0",
    "libsodium-wrappers-sumo": "^0.8.4",
    "lucide-react": "^1.61.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socks": "^2.8.10",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dadadasir/HopLine.git"
  },
  "homepage": "https://github.com/dadadasir/HopLine"
}
